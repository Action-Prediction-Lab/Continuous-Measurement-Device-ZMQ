# ZMQ publisher endpoint (PUB socket for live event stream)
ZMQ_HOST=*
ZMQ_PORT=5580

# Control plane (REP socket for session-mark annotations)
CONTROL_PORT=5581

# Host directory for JSONL trace files (mounted to /logs in the container)
LOG_DIR=./logs

# Target device, USB vendor:product (hex, lowercase, no 0x prefix)
DEVICE_VID=c001
DEVICE_PID=1dea

# Optional opaque session identifier.
# If set, JSONL filename becomes cmd_${SESSION_ID}_${start_iso}.jsonl
# and the meta record carries session_id=<value>.
# SESSION_ID=
